# Salin file ini ke .env.local dan isi nilainya.
# Jangan commit .env / .env.local — keduanya sudah di-ignore git.

# Neon Postgres connection string (serverless driver)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/database?sslmode=require

# Secret untuk next-auth (generate: openssl rand -base64 32)
AUTH_SECRET=change-me

# Token Vercel Blob untuk upload foto profil (opsional, jika pakai avatar)
BLOB_READ_WRITE_TOKEN=

# Khusus untuk seed script admin (development, tidak dipakai runtime)
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASS=
